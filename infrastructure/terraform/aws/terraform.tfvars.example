# Terraform AWS Variables File - Development Environment
# Copy this file to terraform.tfvars and fill in your values

aws_region = "us-east-1"
environment = "development"

# VPC Configuration
vpc_cidr              = "10.0.0.0/16"
public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs  = ["10.0.10.0/24", "10.0.11.0/24"]

# EKS Configuration
cluster_name          = "civicbirth-eks"
kubernetes_version    = "1.28"
instance_type         = "t3.large"
desired_node_count    = 2
min_node_count        = 1
max_node_count        = 5

# RDS Configuration
db_identifier         = "civicbirth-postgres"
db_name               = "civicbirth"
db_username           = "postgres"
db_password           = "CHANGE_ME_STRONG_PASSWORD_HERE"  # Change this!
db_engine_version     = "15.3"
db_instance_class     = "db.t3.small"
db_allocated_storage  = 50
db_max_allocated_storage = 500
db_multi_az           = false  # Set to true for production
db_backup_retention_days = 7   # Set to 30 for production

# Monitoring
# alarm_actions = ["arn:aws:sns:us-east-1:ACCOUNT_ID:your-sns-topic"]
