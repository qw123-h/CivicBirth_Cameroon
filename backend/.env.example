# ── Database ──
DATABASE_URL=postgresql://civicbirth_user:civicbirth_pass@localhost:5432/civicbirth_db

# ── Authentication ──
JWT_SECRET=replace_with_minimum_64_character_random_string_use_openssl_rand_base64_32
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# ── Server ──
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ── Frontend ──
FRONTEND_URL=http://localhost:5173

# ── Supabase Storage ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_STORAGE_BUCKET=certificates

# ── App ──
APP_BASE_URL=http://localhost:3000
CERTIFICATE_VERIFY_BASE_URL=http://localhost:5173/verify
